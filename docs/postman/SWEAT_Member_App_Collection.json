    {
      "name": "05. Membership Self-Service (Freeze / Pause)",
      "description": "Member self-service actions to freeze (pause) their membership or resume early.",
      "item": [
        {
          "name": "5.1 Request Membership Freeze (Pause)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_date\": \"2026-11-01\",\n  \"duration_days\": 14,\n  \"reason\": \"Work travel\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/memberships/freeze/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "memberships", "freeze", ""]
            },
            "description": "Submits a membership freeze request (e.g. for travel or medical reasons) adhering to studio freeze policy."
          }
        },
        {
