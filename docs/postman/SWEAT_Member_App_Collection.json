          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/bookings/{{booking_id}}/qr-pass/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "bookings", "{{booking_id}}", "qr-pass", ""]
            },
            "description": "Generates the dynamic, rotating QR code pass for turnstile scanning and attendance check-in at the studio entrance."
          }
        }
      ]
    },
