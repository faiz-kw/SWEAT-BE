          "name": "3.1 Claim 1st Free Trial Class (New Members)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const id = (res.booking && res.booking.id) || res.id;",
                  "if (id) {",
                  "    pm.environment.set('booking_id', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"occurrence_id\": \"{{occurrence_id}}\",\n  \"full_name\": \"Kavita Rao\",\n  \"phone\": \"{{test_phone}}\",\n  \"email\": \"kavita@example.com\",\n  \"notes\": \"Interested in trying out Reformer Pilates\"\n}"
            },
            "url": {
