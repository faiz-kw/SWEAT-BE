            "url": {
              "raw": "{{base_url}}/api/v1/mobile/branches/nearest/?lat=19.0760&lng=72.8777",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "branches", "nearest", ""],
              "query": [
                { "key": "lat", "value": "19.0760", "description": "Device latitude" },
                { "key": "lng", "value": "72.8777", "description": "Device longitude" }
              ]
            },
            "description": "Automatically sorts SWEAT studio branches by proximity to the member's current location."
          }
        },
        {
          "name": "2.3 Browse Class Types & Modalities",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
