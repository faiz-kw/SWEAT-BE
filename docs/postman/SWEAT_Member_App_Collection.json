{
  "info": {
    "name": "SWEAT Member Mobile App API Suite",
    "_postman_id": "b3e9a110-482a-4c91-b10d-930206169002",
    "description": "Clean, 100% Member-Centric Postman Collection for SWEAT Mobile Application (iOS/Android/React Native/Flutter). Contains only what an end-user / member interacts with: Passwordless OTP login, PAR-Q medical clearance, studio discovery, timetable schedule, 1st free trial & class booking, dynamic turnstile check-in QR pass, session credit balances, package purchasing with Razorpay checkout, and membership freeze controls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Onboarding & Authentication",
      "description": "Passwordless phone number OTP login (WhatsApp Gupshup/SMS), member profile management, and PAR-Q medical health survey clearance.",
      "item": [
        {
          "name": "1.1 Request Login OTP (WhatsApp / SMS)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"tenant_slug\": \"{{tenant_slug}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/send/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "otp", "send", ""]
            },
            "description": "Dispatches a 6-digit OTP code to the member's phone via WhatsApp (approved Gupshup template `auto_verification_otp_message`) or SMS. Has 60s cooldown."
          }
        },
        {
          "name": "1.2 Verify OTP & Auto-Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const token = res.access_token || (res.tokens && res.tokens.access);",
                  "if (token) {",
                  "    pm.environment.set('access_token', token);",
                  "    console.log('Member access token saved.');",
                  "}",
                  "const refreshToken = res.refresh_token || (res.tokens && res.tokens.refresh);",
                  "if (refreshToken) {",
                  "    pm.environment.set('refresh_token', refreshToken);",
                  "}",
                  "if (res.user && res.user.id) {",
                  "    pm.environment.set('user_id', res.user.id);",
                  "}",
                  "if (res.user && res.user.home_branch && res.user.home_branch.id) {",
                  "    pm.environment.set('branch_id', res.user.home_branch.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"otp\": \"123456\",\n  \"tenant_slug\": \"{{tenant_slug}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/verify/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "otp", "verify", ""]
            },
            "description": "Verifies 6-digit OTP. Automatically registers new member profile if first time. Automatically stores JWT `access_token` into Postman environment."
          }
        },
        {
          "name": "1.3 Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const token = res.access || res.access_token;",
                  "if (token) {",
                  "    pm.environment.set('access_token', token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token", "refresh", ""]
            },
            "description": "Refreshes expired access token in the background so member stays logged in."
          }
        },
        {
          "name": "1.4 Get My Profile & Membership Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "me", ""]
            },
            "description": "Returns member details: full name, phone, member number, home branch, avatar, and active membership status."
          }
        },
        {
          "name": "1.5 Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Kavita\",\n  \"last_name\": \"Rao\",\n  \"gender\": \"FEMALE\",\n  \"date_of_birth\": \"1996-08-20\",\n  \"emergency_contact_name\": \"Suresh Rao\",\n  \"emergency_contact_phone\": \"+919876500000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "me", ""]
            },
            "description": "Updates member's personal information and emergency contact."
          }
        },
        {
          "name": "1.6 Get Health Questionnaire (PAR-Q Survey)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/onboarding/survey/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "onboarding", "survey", ""]
            },
            "description": "Retrieves medical readiness questions (heart condition, joint pains, dizziness, surgery) that members complete before booking their first session."
          }
        },
        {
          "name": "1.7 Submit Health Questionnaire & Clearances",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"question_code\": \"HEART_CONDITION\",\n      \"answer_boolean\": false\n    },\n    {\n      \"question_code\": \"JOINT_PAIN\",\n      \"answer_boolean\": false\n    },\n    {\n      \"question_code\": \"FITNESS_GOAL\",\n      \"answer_text\": \"Core strength and fat loss with Pilates & Bootcamp\"\n    }\n  ],\n  \"terms_accepted\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/onboarding/submit/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "onboarding", "submit", ""]
            },
            "description": "Submits health clearance so member is officially cleared to book workout sessions."
          }
        }
      ]
    },
    {
      "name": "02. Studio Discovery & Schedule",
      "description": "Locate SWEAT studio branches, explore class types (Pilates, Bootcamp, PT), and view the live class timetable.",
      "item": [
        {
          "name": "2.1 List Studio Branches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const list = Array.isArray(res) ? res : (res.results || []);",
                  "if (list.length > 0 && !pm.environment.get('branch_id')) {",
                  "    pm.environment.set('branch_id', list[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/branches/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "branches", ""]
            },
            "description": "Returns all SWEAT studio locations with full addresses, amenities, opening/closing hours, and contact details."
          }
        },
        {
          "name": "2.2 Find Nearest Branch via GPS Coordinates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
