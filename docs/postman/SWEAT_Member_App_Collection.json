          }
        },
        {
          "name": "2.4 Get Daily Class Timetable (Available Slots)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const list = Array.isArray(res) ? res : (res.results || []);",
                  "if (list.length > 0) {",
                  "    pm.environment.set('occurrence_id', list[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
