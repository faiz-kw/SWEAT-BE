{
  "info": {
    "name": "SWEAT Studio & Mobile App API Suite",
    "_postman_id": "c1f7a810-724a-4b95-a50d-830206169001",
    "description": "Comprehensive REST API collection for SWEAT Mobile Application (iOS/Android), Trainer Tablet Cockpit, and Studio Display integrations. Covers passwordless OTP authentication (Gupshup WhatsApp/SMS), studio schedules, class bookings, QR check-in passes, membership credits, Razorpay checkout, and the Assessment & Transformation engine.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Authentication & Session",
      "description": "Passwordless phone number OTP login (Gupshup WhatsApp/SMS) and session management.",
      "item": [
        {
          "name": "1.1 Request Login OTP (WhatsApp / SMS)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"tenant_slug\": \"{{tenant_slug}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/send/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "otp", "send", ""]
            },
            "description": "Dispatches a 6-digit OTP code to the user's mobile number via WhatsApp (Gupshup approved template `auto_verification_otp_message`) or SMS. Has a 60-second cooldown protection."
          }
        },
        {
          "name": "1.2 Verify OTP & Issue JWT Bearer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token || (res.tokens && res.tokens.access)) {",
                  "    const token = res.access_token || res.tokens.access;",
                  "    pm.environment.set('access_token', token);",
                  "    console.log('Access token stored successfully.');",
                  "}",
                  "if (res.refresh_token || (res.tokens && res.tokens.refresh)) {",
                  "    pm.environment.set('refresh_token', res.refresh_token || res.tokens.refresh);",
                  "}",
                  "if (res.user && res.user.id) {",
                  "    pm.environment.set('user_id', res.user.id);",
                  "}",
                  "if (res.user && res.user.home_branch && res.user.home_branch.id) {",
                  "    pm.environment.set('branch_id', res.user.home_branch.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"otp\": \"123456\",\n  \"tenant_slug\": \"{{tenant_slug}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/otp/verify/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "otp", "verify", ""]
            },
            "description": "Verifies the 6-digit OTP code. Auto-creates member account if first time. Stores the returned JWT `access_token` automatically into Postman environment variables."
          }
        },
        {
          "name": "1.3 Staff / Admin Login (Email & Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access || res.access_token) {",
                  "    pm.environment.set('access_token', res.access || res.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin@sweat.studio\",\n  \"password\": \"YourStrongPasswordHere!\",\n  \"org_code\": \"{{tenant_slug}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login", ""]
            },
            "description": "Standard login for trainers, front desk staff, and studio admins using email and password."
          }
        },
        {
          "name": "1.4 Refresh JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access || res.access_token) {",
                  "    pm.environment.set('access_token', res.access || res.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token", "refresh", ""]
            },
            "description": "Generates a fresh access token using the long-lived refresh token."
          }
        },
        {
          "name": "1.5 Get Authenticated User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "me", ""]
            },
            "description": "Returns current logged-in member details: name, phone, member number, home branch, avatar, and active package entitlements."
          }
        },
        {
          "name": "1.6 Update User Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Priya\",\n  \"last_name\": \"Sharma\",\n  \"gender\": \"FEMALE\",\n  \"date_of_birth\": \"1995-06-15\",\n  \"emergency_contact_name\": \"Rahul Sharma\",\n  \"emergency_contact_phone\": \"+919876500000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "me", ""]
            },
            "description": "Updates profile details for the authenticated member."
          }
        }
      ]
    },
    {
      "name": "02. Studio Catalog & Schedule",
      "description": "Studio locations, modalities (Pilates, Bootcamp, PT), instructors, and live class schedules.",
      "item": [
        {
          "name": "2.1 List All Studio Branches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const list = Array.isArray(res) ? res : (res.results || []);",
                  "if (list.length > 0 && !pm.environment.get('branch_id')) {",
                  "    pm.environment.set('branch_id', list[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/branches/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "branches", ""]
            },
            "description": "Lists all active SWEAT studio locations with addresses, geo-coordinates, operating hours, and contact numbers."
          }
        },
        {
          "name": "2.2 Find Nearest Branch (Geo-Location)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/branches/nearest/?lat=19.0760&lng=72.8777",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "branches", "nearest", ""],
              "query": [
                { "key": "lat", "value": "19.0760", "description": "Latitude" },
                { "key": "lng", "value": "72.8777", "description": "Longitude" }
              ]
            },
            "description": "Finds the nearest SWEAT studio branch sorted by distance in kilometers."
          }
        },
        {
          "name": "2.3 List Class Categories & Program Modalities",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/class-categories/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "class-categories", ""]
            },
            "description": "Returns program modalities configured in the system: Pilates, Bootcamp, 1:1 Personal Training, Glutes, Strength & Conditioning."
          }
        },
        {
          "name": "2.4 List Coaches & Trainers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/trainers/?branch_id={{branch_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "trainers", ""],
              "query": [
                { "key": "branch_id", "value": "{{branch_id}}", "description": "Optional branch filter" }
              ]
            },
            "description": "Returns trainer profiles: names, bios, specialties (e.g. Reformer Pilates, HIIT Bootcamp), and photos."
          }
        },
        {
          "name": "2.5 Get Daily Studio Schedule & Available Occurrences",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const list = Array.isArray(res) ? res : (res.results || []);",
                  "if (list.length > 0) {",
                  "    pm.environment.set('occurrence_id', list[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/schedule/?branch_id={{branch_id}}&date=2026-10-24",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "schedule", ""],
              "query": [
                { "key": "branch_id", "value": "{{branch_id}}" },
                { "key": "date", "value": "2026-10-24", "description": "YYYY-MM-DD" }
              ]
            },
            "description": "Returns scheduled class sessions for the chosen date: start/end time, trainer, modality, spots remaining, waitlist status, and trial eligibility."
          }
        }
      ]
    },
    {
      "name": "03. Bookings, Free Trials & Turnstile Passes",
      "description": "Session reservation, free trial booking, cancellation, and turnstile QR check-in passes.",
      "item": [
        {
          "name": "3.1 Claim Free Trial Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.booking && res.booking.id) {",
                  "    pm.environment.set('booking_id', res.booking.id);",
                  "} else if (res.id) {",
                  "    pm.environment.set('booking_id', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"occurrence_id\": \"{{occurrence_id}}\",\n  \"full_name\": \"Sneha Patel\",\n  \"phone\": \"+919876543210\",\n  \"email\": \"sneha@example.com\",\n  \"notes\": \"Interested in Pilates Reformer trial\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/bookings/claim-free-trial/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "bookings", "claim-free-trial", ""]
            },
            "description": "Allows a new lead/customer to claim a free trial slot for any trial-eligible class occurrence."
          }
        },
        {
          "name": "3.2 Book Class (Members with Credit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.environment.set('booking_id', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"occurrence_id\": \"{{occurrence_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/bookings/book/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "bookings", "book", ""]
            },
            "description": "Consumes 1 session credit from the member's active membership package (e.g. 72 or 144 session pack) and books the class slot."
          }
        },
        {
          "name": "3.3 Get My Bookings (Upcoming & Past)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/bookings/my-bookings/?status=UPCOMING",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "bookings", "my-bookings", ""],
              "query": [
                { "key": "status", "value": "UPCOMING", "description": "UPCOMING or COMPLETED or CANCELLED" }
              ]
            },
            "description": "Returns upcoming and historical bookings for the logged-in member."
          }
        },
        {
          "name": "3.4 Cancel Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Schedule conflict\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/bookings/{{booking_id}}/cancel/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "bookings", "{{booking_id}}", "cancel", ""]
            },
            "description": "Cancels a booked class. If cancelled before cutoff (e.g. 2 hours), the credit is automatically restored to the member's package."
          }
        },
        {
          "name": "3.5 Reschedule Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_occurrence_id\": \"{{occurrence_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/bookings/{{booking_id}}/reschedule/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "bookings", "{{booking_id}}", "reschedule", ""]
            },
            "description": "Transfers the booking to an alternate scheduled class time without losing session credit."
          }
        },
        {
          "name": "3.6 Get Dynamic QR Access Pass",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/bookings/{{booking_id}}/qr-pass/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "bookings", "{{booking_id}}", "qr-pass", ""]
            },
            "description": "Generates a time-sensitive encrypted QR code for turnstile scanning and attendance check-in at the studio entrance."
          }
        }
      ]
    },
    {
