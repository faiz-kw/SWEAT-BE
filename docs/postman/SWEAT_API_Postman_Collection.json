    {
      "name": "05. Membership Actions (Freeze & Extensions)",
      "description": "Member self-service options for pausing/freezing memberships and validity extensions.",
      "item": [
        {
          "name": "5.1 Request Membership Freeze (Pause)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Slug", "value": "{{tenant_slug}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_date\": \"2026-11-01\",\n  \"duration_days\": 14,\n  \"reason\": \"Work travel\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/memberships/freeze/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "memberships", "freeze", ""]
            },
            "description": "Submits a membership freeze request adhering to studio configuration rules."
          }
        },
